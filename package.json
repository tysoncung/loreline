{
  "name": "@tysoncung/loreline",
  "version": "0.2.0",
  "description": "Turn undocumented organizational knowledge into verified, AI-ready context.",
  "type": "module",
  "bin": {
    "loreline": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./schemas/v1/config": "./schemas/v1/config.schema.json",
    "./schemas/v1/readiness": "./schemas/v1/readiness.schema.json",
    "./schemas/v2/readiness": "./schemas/v2/readiness.schema.json",
    "./schemas/v1/interview": "./schemas/v1/interview.schema.json",
    "./schemas/v2/interview": "./schemas/v2/interview.schema.json",
    "./schemas/v1/session": "./schemas/v1/session.schema.json",
    "./schemas/v1/context": "./schemas/v1/context.schema.json",
    "./schemas/v2/context": "./schemas/v2/context.schema.json",
    "./schemas/v1/verification": "./schemas/v1/verification.schema.json",
    "./schemas/v1/reviews": "./schemas/v1/reviews.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai-readiness",
    "knowledge-transfer",
    "documentation",
    "cli",
    "handoff"
  ],
  "author": "Tyson Cung",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tysoncung/loreline.git"
  },
  "bugs": {
    "url": "https://github.com/tysoncung/loreline/issues"
  },
  "homepage": "https://github.com/tysoncung/loreline#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
