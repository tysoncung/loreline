{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loreline.dev/schemas/v1/config.schema.json",
  "title": "Loreline configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "scan", "output"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude", "maxFiles"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "maxFiles": { "type": "integer", "minimum": 1 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 }
      }
    }
  }
}
