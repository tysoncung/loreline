{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loreline.dev/schemas/v1/context.schema.json",
  "title": "Loreline compiled knowledge context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "project", "owner", "entries", "unresolved", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "project": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "question", "answer", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "sourceFile"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "sourceFile": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "interviewee", "generatedAt"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "interviewee": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
