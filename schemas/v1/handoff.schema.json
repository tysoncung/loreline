{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loreline.dev/schemas/v1/handoff.schema.json",
  "title": "Loreline handoff plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "project", "risks", "openQuestions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "project": { "type": "string", "minLength": 1 },
    "departing": { "type": "string", "minLength": 1 },
    "departureDate": { "type": "string", "minLength": 1 },
    "methodology": { "type": "string", "minLength": 1 },
    "risks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "severity", "factors", "recommendedTopics", "suggestedValidators"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "type": "number" },
          "factors": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "recommendedTopics": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "suggestedValidators": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "area": { "type": "string", "minLength": 1 }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "sourceFile"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "sourceFile": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verificationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "issues"],
      "properties": {
        "valid": { "type": "boolean" },
        "issues": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
