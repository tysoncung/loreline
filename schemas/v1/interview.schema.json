{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loreline.dev/schemas/v1/interview.schema.json",
  "title": "Loreline interview record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "project",
    "interviewee",
    "interviewer",
    "sourceReport",
    "answers",
    "unanswered"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "project": { "type": "string", "minLength": 1 },
    "interviewee": { "type": "string", "minLength": 1 },
    "interviewer": { "type": "string", "minLength": 1 },
    "sourceReport": { "type": "string", "minLength": 1 },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "question", "reason", "answer"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "sourceFinding": { "type": "string", "minLength": 1 },
          "answer": { "type": "string" }
        }
      }
    },
    "unanswered": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
