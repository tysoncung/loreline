{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loreline.dev/schemas/v1/session.schema.json",
  "title": "Loreline interview session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "createdAt",
    "updatedAt",
    "project",
    "interviewee",
    "interviewer",
    "sourceReport",
    "status",
    "questions",
    "answers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "project": { "type": "string", "minLength": 1 },
    "interviewee": { "type": "string", "minLength": 1 },
    "interviewer": { "type": "string", "minLength": 1 },
    "sourceReport": { "type": "string", "minLength": 1 },
    "status": { "enum": ["open", "completed"] },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "question", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "sourceFinding": { "type": "string", "minLength": 1 }
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "answer", "answeredAt", "author", "revisions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "answer": { "type": "string" },
          "answeredAt": { "type": "string", "format": "date-time" },
          "author": { "type": "string", "minLength": 1 },
          "revisions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["answer", "answeredAt", "author"],
              "properties": {
                "answer": { "type": "string" },
                "answeredAt": { "type": "string", "format": "date-time" },
                "author": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "categories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "findings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
