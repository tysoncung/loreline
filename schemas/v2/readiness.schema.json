{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loreline.dev/schemas/v2/readiness.schema.json",
  "title": "Loreline readiness report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "root", "score", "summary", "findings"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "root": { "type": "string", "minLength": 1 },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "partial", "missing", "filesScanned"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "filesScanned": { "type": "integer", "minimum": 0 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "weight", "evidence", "recommendation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "missing", "partial"] },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "recommendation": { "type": "string", "minLength": 1 },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "fingerprint", "kind"],
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "startLine": { "type": "integer", "minimum": 1 },
                "endLine": { "type": "integer", "minimum": 1 },
                "fingerprint": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["evidence", "inference"] }
              }
            }
          }
        }
      }
    },
    "mode": { "enum": ["repository", "documents"] },
    "unreadable": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "analyzedCommits", "excludedIdentities", "methodology", "areas"],
      "properties": {
        "available": { "type": "boolean" },
        "analyzedCommits": { "type": "integer", "minimum": 0 },
        "excludedIdentities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "methodology": { "type": "string", "minLength": 1 },
        "areas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["area", "commits", "lastChangeAt", "contributors", "topShare"],
            "properties": {
              "area": { "type": "string", "minLength": 1 },
              "commits": { "type": "integer", "minimum": 0 },
              "lastChangeAt": { "type": ["string", "null"], "format": "date-time" },
              "contributors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "commits", "share", "lastCommitAt"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "commits": { "type": "integer", "minimum": 0 },
                    "share": { "type": "number", "minimum": 0, "maximum": 1 },
                    "lastCommitAt": { "type": "string", "format": "date-time" }
                  }
                }
              },
              "topShare": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}
